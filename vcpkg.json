{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "everygraph",
  "version-string": "0.0.0",
  "builtin-baseline": "d186940b2f0c4e8e5b4ff804af57d2a26fbfa091",
  "dependencies": [
    {
      "name": "qtbase",
      "version>=": "6.12.0",
      "default-features": false,
      "features": [
        "freetype",
        "gui",
        "widgets"
      ]
    }
  ],
  "features": {
    "desktop-shell": {
      "description": "Qt Test support for the workbench shell prototype; opt-in so probe builds keep the pinned graph.",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "testlib"
          ]
        }
      ]
    }
  }
}

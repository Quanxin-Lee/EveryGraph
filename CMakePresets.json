{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "EVERYGRAPH_ENABLE_SANITIZERS": "OFF",
        "EVERYGRAPH_ENABLE_TSAN": "OFF"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.4"
      }
    },
    {
      "name": "macos-qt-vcpkg-base",
      "hidden": true,
      "inherits": "macos-base",
      "cacheVariables": {
        "EVERYGRAPH_ENABLE_QT_PROBE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic",
        "VCPKG_HOST_TRIPLET": "arm64-osx",
        "VCPKG_APPLOCAL_DEPS": "OFF"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS arm64 Debug (AppleClang)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS arm64 Release (AppleClang)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-sanitize",
      "displayName": "macOS arm64 Debug with ASan and UBSan",
      "inherits": "macos-debug",
      "cacheVariables": {
        "EVERYGRAPH_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "macos-debug-qt",
      "displayName": "macOS arm64 Debug with Qt Widgets probe (QT_ROOT must point at the Qt prefix)",
      "inherits": "macos-debug",
      "cacheVariables": {
        "EVERYGRAPH_ENABLE_QT_PROBE": "ON",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
      }
    },
    {
      "name": "macos-release-qt",
      "displayName": "macOS arm64 Release with Qt Widgets probe (QT_ROOT must point at the Qt prefix)",
      "inherits": "macos-release",
      "cacheVariables": {
        "EVERYGRAPH_ENABLE_QT_PROBE": "ON",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
      }
    },
    {
      "name": "macos-debug-qt-vcpkg",
      "displayName": "macOS arm64 Debug with Qt Widgets probe from the pinned vcpkg graph (arm64-osx-dynamic; VCPKG_ROOT required)",
      "inherits": "macos-qt-vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release-qt-vcpkg",
      "displayName": "macOS arm64 Release with Qt Widgets probe from the pinned vcpkg graph (arm64-osx-dynamic; VCPKG_ROOT required)",
      "inherits": "macos-qt-vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug (VS 2022 developer shell)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release (VS 2022 developer shell)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "macos-sanitize", "configurePreset": "macos-sanitize" },
    { "name": "macos-debug-qt", "configurePreset": "macos-debug-qt" },
    { "name": "macos-release-qt", "configurePreset": "macos-release-qt" },
    { "name": "macos-debug-qt-vcpkg", "configurePreset": "macos-debug-qt-vcpkg" },
    { "name": "macos-release-qt-vcpkg", "configurePreset": "macos-release-qt-vcpkg" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" }
  ],
  "testPresets": [
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-sanitize",
      "configurePreset": "macos-sanitize",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-debug-qt",
      "configurePreset": "macos-debug-qt",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-release-qt",
      "configurePreset": "macos-release-qt",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-debug-qt-vcpkg",
      "configurePreset": "macos-debug-qt-vcpkg",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-release-qt-vcpkg",
      "configurePreset": "macos-release-qt-vcpkg",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
